# === Supabase ===
# Settings -> API u tvom Supabase projektu
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Settings -> API -> service_role (TAJNI kljuc, nikad ga ne stavljaj u frontend kod, samo u .env)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Polar ===
# Link ka tvom proizvodu iz Polar dashboard-a (Products -> tvoj kurs -> Checkout link)
NEXT_PUBLIC_POLAR_CHECKOUT_URL=https://buy.polar.sh/polar_cl_xxxxxxxxxxxx
# Settings -> Webhooks -> kad napravis webhook, Polar ti da ovaj secret
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Drugi proizvod: paket od 500 promptova (9 eur). Checkout link kao gore, iz Products -> taj proizvod.
NEXT_PUBLIC_POLAR_PROMPTS_CHECKOUT_URL=https://buy.polar.sh/polar_cl_yyyyyyyyyyyy
# ID-jevi proizvoda (ne checkout link, nego ID) - koristi ih webhook da zna koji je
# proizvod kupljen. Nadjes ih u Polar dashboard-u kad otvoris proizvod (Products -> proizvod).
POLAR_COURSE_PRODUCT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLAR_PROMPTS_PRODUCT_ID=yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# === Sajt ===
# Puna adresa sajta (bez / na kraju). Lokalno ostavi ovako, na Vercel-u promeni na pravi domen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
